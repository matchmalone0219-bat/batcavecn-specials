    {
      "id": "asylum-secret-hidden-room",
      "game": "asylum",
      "region": "Arkham Mansion",
      "regionLabel": "阿卡姆庄园",
      "title": "院长办公室墙后的城市蓝图",
      "summary": "地图与侦探模式都不标出的墙后，藏着另一座哥谭的规划。",
      "chapterTitle": "The Secret Room",
      "chapterFrame": 20,
      "kind": "秘密与致敬",
      "spoiler": false,
      "blocks": [
        {
          "title": "一面不会高亮的墙",
          "body": "进入阿卡姆庄园的院长办公室后，书架和墙面看起来像普通装饰。这里的暗室没有出现在地图上，侦探模式也不会把入口标成常见的可破坏墙。视频在墙前反复布置爆炸凝胶，炸开后才露出里面的小房间。",
          "images": [
            "eg01-office",
            "eg01-room"
          ],
          "spoiler": false
        },
        {
          "title": "从岛屿走向城区",
          "body": "墙上的哥谭地图画有围合区域与“Approved”字样。它把疯人院的封闭空间接到下一作的城市监狱构想上：这份留给续作的布景，把下一座舞台提前藏在了岛上。回看时，可以对照地图上的街区与《阿卡姆之城》的封锁边界。",
          "images": [
            "eg01-map"
          ],
          "spoiler": false
        }
      ]
    },
    {
      "id": "asylum-secret-mannequins",
      "game": "asylum",
      "region": "Visitor Center",
      "regionLabel": "访客中心",
      "title": "访客中心里会变换姿势的人偶",
