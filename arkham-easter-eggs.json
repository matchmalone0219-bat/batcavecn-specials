    {
      "id": "asylum-secret-paulis-diner",
      "game": "asylum",
      "region": "Gotham Skyline",
      "regionLabel": "哥谭天际线",
      "title": "开场哥谭天际线上的保罗餐馆招牌",
      "summary": "蝙蝠车疾驰掠过的街角霓虹招牌“Pauli’s Diner”，致敬了核心编剧保罗·丁尼。",
      "chapterTitle": "Pauli’s Diner",
      "chapterFrame": 1400,
      "kind": "创作者致意",
      "spoiler": false,
      "blocks": [
        {
          "title": "车窗外呼啸而过的编剧之名",
          "body": "在序章蝙蝠车押送小丑穿行哥谭市区的运镜中，窗外街角闪过一处醒目的霓虹灯招牌 Pauli’s Diner。这处布景直接致敬了阿卡姆前两作的编剧保罗·丁尼（Paul Dini），其深厚的动画编剧功底构筑了本系列的叙事基石。",
          "images": [
            "eg17-diner"
          ],
          "spoiler": false
        }
      ]
    },
    {
      "id": "asylum-secret-mad-love",
      "game": "asylum",
      "region": "Interview Tapes",
      "regionLabel": "访谈录音",
      "title": "哈莉审讯录音与经典漫画《疯狂的爱》",
      "summary": "问诊录音中步步沉沦的心理转变，与经典名作《Mad Love》形成紧密互文。",
      "chapterTitle": "Mad Love",
      "chapterFrame": 1435,
      "kind": "漫画与动画致敬",
      "spoiler": true,
      "blocks": [
        {
          "title": "诊疗台上的情感陷阱",
          "body": "散落各处的哈莉·奎恩审讯磁带完整重现了哈琳·奎泽尔医生在与小丑的交锋中，如何从自负的心理学者一步步被精神操控并沦为共犯。磁带台词精准复刻了 1994 年经典漫画《疯狂的爱》（Mad Love）中的心理交锋。",
          "images": [
            "eg18-book",
            "eg18-animation"
          ],
          "spoiler": false
        },
        {
          "title": "多媒介叙事的转译与重塑",
          "body": "从 90 年代动画剧集、漫画特刊到本作可交互的录音档案，Rocksteady 将这段悲剧性的心理蜕变拆解为环境收集要素，使玩家在探索中亲历这名反派的诞生史。",
          "images": [],
          "spoiler": false
        }
      ]
    },
    {
      "id": "asylum-secret-the-batman",
      "game": "asylum",
      "region": "Cross Media",
      "regionLabel": "动画对照",
      "title": "终局变身与动画《新蝙蝠侠》的异曲同工",
      "summary": "泰坦小丑的怪兽化身与“第二处家”的表述，呼应了 2004 年版动画的创意构想。",
      "chapterTitle": "The Batman",
      "chapterFrame": 1600,
      "kind": "动画对照",
      "spoiler": true,
      "blocks": [
        {
          "title": "《Brawn》剧集中的肌肉变异小丑",
          "body": "终盘小丑为自己注射泰坦毒剂变身为庞然巨兽的场景，与 2004 年动画系列《新蝙蝠侠》（The Batman）第三季《肌肉》（Brawn）中摄入贝恩毒液后暴走的小丑构想高度契合，均通过打破瘦削小丑传统体型的狂暴反差制造视觉冲击。",
          "images": [
            "eg19-brawn"
          ],
          "spoiler": false
        },
        {
          "title": "离岛蝙蝠洞与“另一个家”的呼应",
          "body": "蝙蝠侠在阿卡姆岛悬崖下建立第二基地并称其为“另一个家”（home away from home）的台词与设定，同样对应《新蝙蝠侠》动画中《奇妙新世界》（Strange New World）对辅助蝙蝠洞的描绘。",
          "images": [
            "eg19-cave"
          ],
          "spoiler": false
        }
      ]
    },
    {
      "id": "asylum-secret-comic-references",
      "game": "asylum",
      "region": "Comic References",
      "regionLabel": "漫画图像与场景",
      "title": "岛内场景向《严肃的屋子》《致命玩笑》与《骑士陨落》的致敬",
      "summary": "折背姿态、黑色幽默门牌与圣甲虫图腾，凝结了数部里程碑级漫画的视觉原型。",
      "chapterTitle": "Comic Books References",
      "chapterFrame": 1685,
      "kind": "秘密与致敬",
      "spoiler": false,
      "blocks": [
        {
          "title": "贝恩终结技与《骑士陨落》断脊",
          "body": "在玩家败于贝恩之手的死亡结算镜头中，贝恩将蝙蝠侠高举并砸向膝盖的动作，以分毫不差的角度精准还原了 1993 年漫画里程碑《骑士陨落》（Knightfall）中摧毁蝙蝠侠脊椎的经典封面。",
          "images": [
            "eg20-knightfall"
          ],
          "spoiler": false
        },
        {
          "title": "重症通道讽刺牌匾与《致命玩笑》",
          "body": "重症治疗大楼安检通道悬挂的讽刺标牌“在这里工作不一定得疯，但疯了肯定有帮助”，文字原型直接出自阿兰·摩尔的名作《致命玩笑》（The Killing Joke）；而小丑审讯录音中声称自己的过去“如同多选题”，同样承袭该作精髓。",
          "images": [
            "eg20-plaque",
            "eg20-interview"
          ],
          "spoiler": false
        },
        {
          "title": "人偶堆积的高座与荒诞狂欢",
          "body": "决战前夕小丑端坐于由无数人体模型与残肢堆叠而成的华丽高座之上，这一舞台布景镜头构图亦致敬了《致命玩笑》中小丑在废弃游乐场拘禁戈登时的审判王座。",
          "images": [
            "eg20-throne"
          ],
          "spoiler": true
        },
        {
          "title": "卡什假肢、杀手鳄与《人间地狱》",
          "body": "警卫阿伦·卡什左手的金属假钩与杀手鳄对其肉体的贪婪执念，源自漫画《阿卡姆疯人院：人间地狱》；而小丑广播中故意播放的机械钟表走字声，则借用了《彼得·潘》中鳄鱼与霍克船长的时钟意象。",
          "images": [
            "eg20-cash",
            "eg20-croc"
          ],
          "spoiler": false
        },
        {
          "title": "《严肃的屋子》中的神秘圣甲虫图腾",
          "body": "金属大门和院史石碑上的圣甲虫浮雕，以及疯人院创始人阿马迪厄斯牢房墙面的密宗同心圆符咒，深度借鉴了格兰特·莫里森 1989 年奠基之作《阿卡姆疯人院：严肃的屋子》（A Serious House on Serious Earth）中的哥特神秘学氛围。",
          "images": [
            "eg20-beetle",
            "eg20-writing",
            "eg20-cover"
          ],
          "spoiler": false
        },
        {
          "title": "院史讲述者身份与卡文迪什的狂热投影",
          "body": "最终揭示夏普院长将自己妄想为阿卡姆创始人之魂转世的悲剧反转，在精神母题上继承了《严肃的屋子》中陷入疯狂的前任主管查尔斯·卡文迪什（Charles Cavendish），揭示了这所疗养院对管理者心灵的世代同化与诅咒。",
          "images": [
            "eg20-sharp",
            "eg20-bell"
          ],
          "spoiler": true
        }
      ]
    }
  ],
