  "notes": [
    {
      "id": "dark-backgrounds",
      "title": "从暗处塑造哥谭",
      "sourceRefs": [
        "tas-radomski"
      ],
      "text": "Radomski将从暗处以光色引出形象的思路联系到Monet、Bernie Fuchs、Coppola与Fleischer动画；他解释这也能用有限细节维持气氛与制作一致性。背景、标题卡与人物剪影共同呈现这套视觉思路。",
      "status": "主创口述摘述；具体画稿待补"
    },
    {
      "id": "production-team",
      "title": "从试片到系列：共同制作",
      "sourceRefs": [
        "tas-radomski",
        "tas-dc-series"
      ],
      "text": "Radomski回忆与Timm制作90秒试片后获任制片，首批目标65集；Alan Burnett加入带来经验与合作。他回忆最多七家工作室在四国同时工作，主体为传统手工二维与胶片拍摄。",
      "status": "制作史入口；原始试片未取得"
    },
    {
      "id": "harley-migration",
      "title": "哈莉：从动画走向漫画",
      "sourceRefs": [
        "tas-harley"
      ],
      "text": "DC回顾将哈莉的动画登场定位在1992年Joker’s Favor，归于Dini与Timm创作，并指出Arleen Sorkin的声音与Timm造型。The Batman Adventures #12是她早期的漫画登场，Batman: Harley Quinn #1则把她带入漫画主连续性。",
      "status": "官方回顾；原刊与片尾未逐项核验"
    },
    {
      "id": "voice-performance",
      "title": "面具之后的英语声音",
      "sourceRefs": [
        "dc-interview"
      ],
      "text": "康罗伊在本人访谈中谈到布鲁斯与蝙蝠侠的表演、共同录音和代表篇目。从英语原声出发，听同一演员怎样让日常生活与英雄行动拥有不同的声音。",
      "status": "已有主档案回用；完整演员表待补"
    },
    {
      "id": "awards-scope",
      "title": "艾美奖记录的范围",
      "sourceRefs": [
        "tas-emmy"
      ],
      "text": "Television Academy在Batman: The Series条目下列出1993年Outstanding Animated Program (For Programming One Hour Or Less)获奖；该条目以系列列名。",
      "status": "机构记录已核；分集与其他奖项待核"
    },
    {
      "id": "mad-love-media",
      "title": "Mad Love：从漫画到动画与再版",
      "sourceRefs": [
        "tas-mad-deluxe",
        "tas-mad-stories",
        "wf-tnba-guide"
      ],
      "text": "原始Mad Love漫画、TNBA动画改编与2011／2015年的再版，各有自己的媒介和版本。沿书目与封面浏览这个故事在纸页和银幕之间的流转。",
      "status": "比较框架；内页与镜头证据待补"
    },
    {
      "id": "continuations",
      "title": "两种延续：漫画与新动画",
      "sourceRefs": [
        "tas-continue-announcement",
        "tas-continue-one",
        "tas-continue-two",
        "dc-caped-intro"
      ],
      "text": "Adventures Continue由原动画主创拓展既有动画世界，Season One／Two是漫画项目的命名。《披风斗士》以独立连续性重写哥谭，可从年代氛围、设计与人物塑造展开比较。",
      "status": "关系已区分；不做统一宇宙推断"
    }
  ],
