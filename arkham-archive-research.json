  "notes": [
    {
      "id": "riddler-as-designer",
      "title": "谜语人为何总要把Batman变成玩家",
      "body": "谜语人的机关可以先当作人物表达来读：他需要有人参与，才能证明自己的聪明。DC的Alex Jaffe在2022年回顾中，把TAS的“游戏设计者”塑造与阿卡姆游戏中的两人关系明确联系起来。这给跨站阅读提供了一条有出处的线索。它支持讨论人物处理的延续，不能据此声称某个游戏关卡直接改编了某集动画。",
      "sources": [
        "dc-riddler-history"
      ],
      "images": [
        "riddler-tas"
      ],
      "status": "可作短档案底稿；逐关对应未证实"
    },
    {
      "id": "riddler-other-career",
      "title": "问号之外：谜语人也曾是侦探",
      "body": "整理谜语人时，可以加入他作为解题者的版本。DC回顾将Dini在2006年Detective Comics中的处理概括为：让Nygma抢先破案，以另一种方式与Batman竞争。官方文章展示了一页相关漫画，并链接#822。资料站可以把它作为人物比较入口；这段漫画经历不能自动移植成阿卡姆游戏人物的过去。",
      "sources": [
        "dc-riddler-history"
      ],
      "images": [
        "riddler-dini-detective"
      ],
      "status": "可作人物比较底稿；图片页码待核"
    },
    {
      "id": "poster-graysons",
      "title": "格雷森海报：城市里留下的家庭记忆",
      "body": "《城》的Amusement Mile有Flying Graysons海报，已有攻略图片可辨认。这张海报适合与官方Robin历史资料并置，说明Dick Grayson的家庭与身份背景。社区哥谭故事目录还将它对应到A New Robin，可作为补核入口。正式档案应保留海报原貌，并将人物背景、游戏解锁关系和本站解读分别写清。",
      "sources": [
        "city-amusement-mile",
        "dc-robin",
        "city-stories"
      ],
      "images": [
        "prior:city-flying-graysons",
        "prior:comic-robin-detective38"
      ],
      "status": "可作场景档案底稿；游戏解锁页待核"
    },
    {
      "id": "city-subsidence-note",
      "title": "沉降告示：一个警示牌能讲多少城市历史",
      "body": "这块告示值得保留为城市资料，而不仅是扫描答案。现有游戏截图和社区Seismic Disturbances条目，可以引导后续核对环境变化与居民处境。与漫画Cataclysm的比较目前仍是编辑研究问题。出现地震、沉降等相似题材，并不足以确认游戏引用了该漫画事件；档案不宜给它加上已证实的改编标签。",
      "sources": [
        "city-park-row",
        "city-stories",
        "dc-cataclysm"
      ],
      "images": [
        "prior:city-subsidence"
      ],
      "status": "研究注释；Cataclysm联系仍未证实"
    },
    {
      "id": "barbara-suit-note",
      "title": "旧战衣：先确认Barbara的不同身份",
      "body": "《骑士》的旧Batgirl战衣可以成为Barbara人物档案的入口。社区目录列出对应故事The Trap，后续应补取游戏解锁页。此前索引中的Batgirl是人物归类，不能冒充故事的正式标题。比较漫画时，应分别核对Batgirl经历、The Killing Joke事件和Oracle身份形成；这几项关联不宜合并成一段未经验证的游戏身世。",
      "sources": [
        "knight-bleake",
        "knight-story-text-index",
        "dc-oracle"
      ],
      "images": [
        "prior:knight-batgirl"
      ],
      "status": "研究注释；故事标题来自社区目录，游戏待核"
    },
    {
      "id": "arkham-book-boundaries",
      "title": "书名里的Arkham，不总是游戏系列",
      "body": "资料站需要给相关漫画注明作品性质。《Arkham City》是官方说明连接两款游戏的漫画；《Arkham Knight #1》被介绍为游戏前传。相比之下，《Batman: Arkham – The Riddler》收录不同年代的角色故事。标题相似不能替代作品关系：配套漫画可用于补充游戏背景，角色选集用于查人物历史，Morrison/McKean的疯人院漫画则另列比较阅读。",
      "sources": [
        "dc-city-comic",
        "dc-knight-comic",
        "dc-riddler-anthology",
        "dc-asylum-comic25"
      ],
      "images": [
