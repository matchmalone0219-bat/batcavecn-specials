    {
      "id": "burnett-origin",
      "title": "电影创作：起源与爱情",
      "text": "Burnett回忆希望以爱情故事从另一角度探索蝙蝠侠起源；他先写详细treatment与剧本前40页，Pasko接墓地段落，Dini承担小丑引入。",
      "sourceRefs": [
        "burnett-interview"
      ],
      "status": "主创回忆；本文不揭示面具人物身份"
    },
    {
      "id": "burnett-rating",
      "title": "PG尺度与院线决定",
      "text": "Burnett回忆为PG尺度间接处理暴力；对于院线决定，他以“据我所知”将其与Radomski的电脑制作片头联系起来。",
      "sourceRefs": [
        "burnett-interview"
      ],
      "status": "口述历史；管理层决定与历史载体需另核"
    },
    {
      "id": "historical-release",
      "title": "回顾文章与版本时间",
      "text": "2014年DC回顾谈到当时的蓝光发行状况，2023年华纳宣布4K修复版。下方包装图展示2023版，电影基础档案则记录1993年原片。",
      "sourceRefs": [
        "phantasm-2014",
        "phantasm-4k"
      ],
      "status": "历史时间层次已区分"
    },
